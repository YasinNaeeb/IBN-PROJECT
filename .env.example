# ═══════════════════════════════════════════════════════════
#  IBN ChatOps — Environment Variables Template
#  Copy this to .env and fill in your real values.
#  Never commit the real .env file.
# ═══════════════════════════════════════════════════════════

# ── Telegram ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# Comma-separated numeric Telegram user IDs allowed to use the bot.
# Leave empty ONLY for local testing — an empty list means anyone can use it.
TELEGRAM_ALLOWED_USERS=
# Public HTTPS URL of the dashboard, if you want a button in the bot
# that opens it as a Telegram Mini App.
DASHBOARD_PUBLIC_URL=
# Chat/group/user ID the bot posts operational alerts to (push
# failures, device online<->offline transitions). Leave empty to
# disable alerting. Get your chat ID by messaging @userinfobot.
TELEGRAM_ALERT_CHAT_ID=

# ── Dashboard ─────────────────────────────────────────────
SECRET_KEY=change_this_to_a_random_string_at_least_32_chars
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change_this_password

# ── Device credentials (used to seed config.py's DEVICES list) ────
DEVICE_USERNAME=admin
DEVICE_PASSWORD=change_this_password
DEVICE_SECRET=change_this_enable_secret

# ── Security ──────────────────────────────────────────────
# Key used to encrypt device credentials stored in the SQLite DB.
# Generate one with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left empty, a key is auto-generated into .encryption_key on first run —
# fine for a local lab, but set this explicitly so credentials survive a
# reinstall/move to another host, and ALWAYS set it for anything beyond a lab.
ENCRYPTION_KEY=

# Set to 1 for any non-lab deployment. The app will refuse to start if
# SECRET_KEY / DASHBOARD_PASSWORD / DEVICE_PASSWORD / DEVICE_SECRET are
# still at their shipped default values.
ENFORCE_SECURE_DEFAULTS=0

# Shared secret the dashboard/bot send to the engine (port 8000) as the
# X-API-Key header. Leave empty ONLY for a lab kept on localhost — an
# empty value means the engine accepts unauthenticated requests, which
# previously was the only option. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
ENGINE_API_KEY=

# Minutes between automatic "safety net" backups of every device, taken
# independently of any push. 0 disables the scheduler.
SCHEDULED_BACKUP_INTERVAL_MINUTES=0

# How often (seconds) to persist a CPU/memory/online sample per device
# for the Monitoring page's history graphs, and how long to keep samples.
METRICS_HISTORY_INTERVAL_SECONDS=60
METRICS_HISTORY_RETENTION_HOURS=168

# ── Model ─────────────────────────────────────────────────
# Folder name must match where you copy your trained model
# (see README.md / models/PUT_MODEL_HERE.txt).
MODEL_PATH=models/ibn_dleberta
CONFIDENCE_THRESHOLD=0.50

# ── Database ──────────────────────────────────────────────
# DB_PATH=
