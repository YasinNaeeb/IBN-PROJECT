# ═══════════════════════════════════════════════════════════
#  IBN ChatOps — Environment Variables (real file)
#  Generated from .env.example and cross-checked against
#  config.py, docker-compose.yml, start_all.sh/.bat, README.md
#  Never commit this file (it's already in .gitignore).
# ═══════════════════════════════════════════════════════════

# ── Telegram ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=8296103222:AAECIbon8O1YNsIiFBpALJODQB1oaLW1Eg4
# Comma-separated numeric Telegram user IDs allowed to use the bot.
# Leave empty ONLY for local testing — an empty list means anyone can use it.
TELEGRAM_ALLOWED_USERS=894977257
# Public HTTPS URL of the dashboard, if you want a button in the bot
# that opens it as a Telegram Mini App.
DASHBOARD_PUBLIC_URL=
# Chat/group/user ID the bot posts operational alerts to (push
# failures, device online<->offline transitions). Leave empty to
# disable alerting. Get your chat ID by messaging @userinfobot.
TELEGRAM_ALERT_CHAT_ID=

# ── Dashboard ─────────────────────────────────────────────
# Randomly generated for you — safe to keep as-is.
SECRET_KEY=Zjri-NmerRyYt-SDo3BWc0W0WQrmKtv49ysouXI5P7DJymDxxdMwLXiQ1iotjuMa
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=ysn2001

# ── Device credentials (used to seed config.py's DEVICES list) ────
# Set to admin/admin/admin based on your message — matches the lab
# defaults in config.py's _INSECURE_DEFAULTS. Change if this isn't
# what's actually configured on your PNetLab routers/switches.
DEVICE_USERNAME=admin
DEVICE_PASSWORD=admin
DEVICE_SECRET=admin

# ── Security ──────────────────────────────────────────────
# Key used to encrypt device credentials stored in the SQLite DB.
# Randomly generated for you with Fernet.generate_key() — safe to keep,
# but back it up: if you lose it, previously-stored device credentials
# in the DB become undecryptable.
ENCRYPTION_KEY=YGCpp9r3xA5vRKJQ9Z7z9ZabamHpUZC1-V9UDoMx83w=

# Set to 1 for any non-lab deployment. The app will refuse to start if
# SECRET_KEY / DASHBOARD_PASSWORD / DEVICE_PASSWORD / DEVICE_SECRET are
# still at their shipped default values.
ENFORCE_SECURE_DEFAULTS=0

# ── New: engine API auth / scheduled backups / metrics history ────
# Shared secret the dashboard/bot send to the engine as X-API-Key.
# Empty = engine accepts unauthenticated requests (old behavior).
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
ENGINE_API_KEY=

# 0 = periodic backup scheduler disabled. Set e.g. 60 for hourly.
SCHEDULED_BACKUP_INTERVAL_MINUTES=0

# Monitoring page history graphs: sampling interval + retention.
METRICS_HISTORY_INTERVAL_SECONDS=60
METRICS_HISTORY_RETENTION_HOURS=168

# ── Model ─────────────────────────────────────────────────
# Set to your actual model folder (confirmed: models/ibn_dleberta).
MODEL_PATH=models/ibn_dleberta
CONFIDENCE_THRESHOLD=0.50

# ── Database ──────────────────────────────────────────────
# DB_PATH=
